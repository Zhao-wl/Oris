# 依赖
node_modules/

# 前端构建产物
dist/
.vite/
*.tsbuildinfo
# tsc -b 由 vite.config.ts 生成
vite.config.js
vite.config.d.ts

# Rust / Tauri 构建产物（target/ 匹配任意层级，含 src-tauri/target/）
target/
src-tauri/gen/
**/*.rs.bk
*.pdb

# 验证运行产物（截图、日志、夹具 JSON）；结论写入 docs/validation/
artifacts/*/runtime/
artifacts/*-feedback/
# 任务内独立 Cargo 构建目录
artifacts/*/build/
# 源码哈希清单与 git 提交哈希重复，不入库
artifacts/*/SHA256SUMS.txt

# 测试覆盖率
coverage/

# 日志
*.log
npm-debug.log*

# 本地环境与私有配置
.env
.env.*
!.env.example
*.local
.claude/settings.local.json

# 本地工具缓存
.code-review-graph/

# 编辑器
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# 操作系统
Thumbs.db
Desktop.ini
.DS_Store
